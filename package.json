{
  "name": "@quickauth/react-native",
  "version": "1.2.0",
  "description": "QuickAuth React Native SDK — phone OTP authentication and WhatsApp marketing attribution",
  "homepage": "https://quickauth.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/quickauthin/quickauth-sdk-react-native"
  },
  "bugs": {
    "url": "https://github.com/quickauthin/quickauth-sdk-react-native/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "scripts",
    "lib",
    "android",
    "ios",
    "react-native.config.js",
    "QuickAuthRnSdk.podspec",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "version:sync": "node scripts/sync-version.js",
    "prebuild": "node scripts/sync-version.js",
    "build": "bob build",
    "pretest": "node scripts/sync-version.js --check",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "quickauth",
    "otp",
    "auth",
    "whatsapp",
    "attribution",
    "sms-retriever"
  ],
  "author": "QuickAuth <contact@quickauth.in>",
  "license": "MIT",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.72.0",
    "react-native-builder-bob": "^0.23.2",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts",
      "<rootDir>/__tests__/**/*.test.tsx"
    ],
    "moduleNameMapper": {
      "^react-native$": "<rootDir>/__tests__/__mocks__/react-native.ts",
      "^@react-native-async-storage/async-storage$": "<rootDir>/__tests__/__mocks__/async-storage.ts"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/tsconfig.json"
        }
      ]
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": false
        }
      ],
      [
        "module",
        {
          "esm": false
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
